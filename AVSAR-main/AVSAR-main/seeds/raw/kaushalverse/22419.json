{"nsqcNumberId": 35, "qualVersionId": null, "image": null, "nqrCode": "QG-02-TX-01938-2024-V2-TSC", "nameOfQualification": "Sizing Machine Operator", "description": "A Sizing machine operator is responsible for sizing of yarn as per the required parameters in the weaving preparatory department. The responsibility of a Sizing machine operator is to run the Sizing Machine efficiently so as to get maximum output with minimum defects giving due importance to safety and environment aspects. The job requires the individual to have thorough knowledge of process flow and material flow in a Weaving mill for fabric production and should know about the important functions and operations of Sizing machine.", "qualCategoryText": "QUALIFICATION", "qFileAttachId": 131218609, "categoryOfQual": "Qualification", "nosWithMCFlag": false, "nsqfLevel": "2", "sector": "Textile and Handloom", "awardingBodyName": "Textile Sector Skill Council", "typeOfQualification": "General, Upskilling, Fresh Skilling", "isAdopted": null, "fromWhomHeAdopted": null, "leaningUnitGrid": [{"NSQF_LEVEL": "2", "CREDITS": 2.0, "SR_NO": 1, "NATIONAL_HOURS": 60, "NAME": "Taking charge of shift and handing over shift to Sizing machine operator"}, {"NSQF_LEVEL": "2", "CREDITS": 5.0, "SR_NO": 2, "NATIONAL_HOURS": 150, "NAME": "Run the sizing machine"}, {"NSQF_LEVEL": "3", "CREDITS": 0.5, "SR_NO": 3, "NATIONAL_HOURS": 15, "NAME": "Comply with industry and organizational requirement"}, {"NSQF_LEVEL": "3", "CREDITS": 1.5, "SR_NO": 4, "NATIONAL_HOURS": 45, "NAME": "Maintain health, safety and security at workplace"}, {"NSQF_LEVEL": "3", "CREDITS": 0.5, "SR_NO": 5, "NATIONAL_HOURS": 15, "NAME": "Maintain work area, tools and machines"}, {"NSQF_LEVEL": "3", "CREDITS": 0.5, "SR_NO": 6, "NATIONAL_HOURS": 15, "NAME": "Working in a team"}, {"NSQF_LEVEL": "3", "CREDITS": 1.0, "SR_NO": 7, "NATIONAL_HOURS": 30, "NAME": "Employability Skills"}], "eligibilityCriteriaGrid": [{"PURSUINGSPECIALIZATION": null, "NCRF_NSQF_LVL": "2", "ED