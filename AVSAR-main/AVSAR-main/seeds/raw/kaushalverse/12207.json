{"nsqcNumberId": 41, "qualVersionId": null, "image": 131147645, "nqrCode": "NM-06-HY-03836-2025-V1-HSSC", "nameOfQualification": "Green Hydrogen System Design", "description": "An individual in this job role is responsible for designing and implementing systems to produce green hydrogen, a sustainable and environmentally friendly energy carrier. Individual in this job role typically encompass a range of responsibilities and qualifications that covers Project Planning and Feasibility, Design and Engineering, Renewable Energy Integration, Electrolysis System Design, Process Optimization, Instrumentation and Control, Environmental and Safety Compliance, Economic Analysis, Procurement and Construction Oversight, Collaboration and Communication, Continuous Learning. The person at this job shall have deep understanding of the mechanical and electrical principles and processes involved in air separation and hydrogen generation. Adherence to process Safety and safety protocol during the production process is also one of the primary responsibilities of the Plant Manager.", "qualCategoryText": "QUALIFICATION", "qFileAttachId": 131169956, "categoryOfQual": "Qualification", "nosWithMCFlag": false, "nsqfLevel": "6", "sector": "Hydrocarbon", "awardingBodyName": "Hydrocarbon Sector Skill Council", "typeOfQualification": "General, Upskilling, Future Skills", "isAdopted": null, "fromWhomHeAdopted": null, "leaningUnitGrid": [{"NSQF_LEVEL": "6", "CREDITS": 1.0, "SR_NO": 1, "NATIONAL_HOURS": 30, "NAME": "Green Hydrogen System Design"}], "eligibilityCriteriaGrid": [{"PURSUINGSPECIALIZATION": null, "NCRF_NSQF_LVL": "6", "EDUCATIONPURSUING": null, "PREVNSQFLEVELSACHIEVED": null, "SR_NO": 1, "LTTSTTCOMPLETED": null, "REMARKS": null, "RELEVANTSPECIALIZATION": null, "EDUCATIONCOMPLETED": "Completed 4th year BE/B tech Engineering", "RELAVANTEXPERIENCEINYEARS": "1.5 years relevant experience", "COMPLETEDSPECIALIZATION": "Chemical/Industrial/ Petrochemical / Electrical Mechanical branch", "SPEC