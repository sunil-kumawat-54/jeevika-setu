{"nsqcNumberId": 38, "qualVersionId": null, "image": 131163097, "nqrCode": "QG-05-EH-02594-2024-V1-NIELIT", "nameOfQualification": "Junior Chip Designer (A-Level Chip Design)", "description": "The A-Level Chip Design program is designed to equip learners with comprehensive knowledge and practical skills in VLSI System-on-Chip (SoC) design, verification, and FPGA-based prototyping. The curriculum covers key areas such as Verilog HDL, FPGA architecture, SystemVerilog and UVM-based verification, processor architectures, bus protocols, FPGA emulation, High-Level Synthesis (HLS), and post-silicon validation. Through hands-on projects and industry-standard tools, learners develop competencies in designing, verifying, testing, and validating complex SoC solutions. The program prepares participants for careers in semiconductor design, ASIC/SoC verification, FPGA development, and embedded systems by enhancing their technical expertise, problem-solving abilities, and industry readiness while supporting innovation in the semiconductor and electronics sector.", "qualCategoryText": "QUALIFICATION", "qFileAttachId": 131163933, "categoryOfQual": "Qualification", "nosWithMCFlag": false, "nsqfLevel": "5", "sector": "Electronics and HW", "awardingBodyName": "National Institute of Electronics and Information Technology ", "typeOfQualification": "General, Future Skills", "isAdopted": null, "fromWhomHeAdopted": null, "leaningUnitGrid": [{"NSQF_LEVEL": "5", "CREDITS": 3.0, "SR_NO": 1, "NATIONAL_HOURS": 90, "NAME": "OJT/Project"}, {"NSQF_LEVEL": "5", "CREDITS": 3.0, "SR_NO": 2, "NATIONAL_HOURS": 90, "NAME": "Employability Skill"}, {"NSQF_LEVEL": "5", "CREDITS": 2.0, "SR_NO": 3, "NATIONAL_HOURS": 60, "NAME": "SOC Design and Verification"}, {"NSQF_LEVEL": "5", "CREDITS": 2.0, "SR_NO": 4, "NATIONAL_HOURS": 60, "NAME": "Accelerator design using HLS programming"}, {"NSQF_LEVEL": "5", "CREDITS": 2.0, "SR_NO": 5, "NATIONAL_HOURS": 60, "NAME": "VLSI Physical Design and Verification"}, {"NSQF_LEVE