{"nsqcNumberId": 43, "qualVersionId": null, "image": 131167084, "nqrCode": "QG-04-RI-05374-2026-V1-RCPSDC", "nameOfQualification": "Grader (Ribbed smoked sheet Trading)", "description": "The Grader - Ribbed Smoked Sheet (RSS) Trading is responsible for inspecting, classifying, and grading smoked rubber sheets based on BIS/ISO standards, ensuring proper documentation, labeling, and storage to maintain quality and traceability. The role involves visual inspection, identification of defects, applying grading criteria, maintaining records, labeling batches, and adhering to sustainable, safe handling, and storage practices as per trading and export norms. The individual works under supervision, follows industry standards, and ensures consistent product quality to meet customer and export specifications.", "qualCategoryText": "QUALIFICATION", "qFileAttachId": 131210064, "categoryOfQual": "Qualification", "nosWithMCFlag": false, "nsqfLevel": "4", "sector": "Rubber Industry", "awardingBodyName": "Rubber Chemical and Polymer Skill Development Council", "typeOfQualification": "General, Fresh Skilling, For ToT, For ToA", "isAdopted": null, "fromWhomHeAdopted": null, "leaningUnitGrid": [{"NSQF_LEVEL": "4", "CREDITS": 7.0, "SR_NO": 1, "NATIONAL_HOURS": 230, "NAME": "Inspect and Sort Rubber Sheets for Grading"}, {"NSQF_LEVEL": "4", "CREDITS": 4.0, "SR_NO": 2, "NATIONAL_HOURS": 140, "NAME": "Ensure Proper Documentation and Labeling of Grading"}, {"NSQF_LEVEL": "4", "CREDITS": 2.0, "SR_NO": 3, "NATIONAL_HOURS": 80, "NAME": "Follow Handling and Storage Practices"}, {"NSQF_LEVEL": "4", "CREDITS": 1.0, "SR_NO": 4, "NATIONAL_HOURS": 30, "NAME": "Follow ethical and sustainable practices at the workplace"}, {"NSQF_LEVEL": "2", "CREDITS": 1.0, "SR_NO": 5, "NATIONAL_HOURS": 30, "NAME": "Employability Skills (30 Hours)"}], "eligibilityCriteriaGrid": [{"PURSUINGSPECIALIZATION": null, "NCRF_NSQF_LVL": "4", "EDUCATIONPURSUING": null, "PREVNSQFLEVELSACHIEVED": null, "SR_NO": 1, "LTTSTTCOMPLETED