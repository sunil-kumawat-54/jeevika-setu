{"nsqcNumberId": 35, "qualVersionId": null, "image": 131105283, "nqrCode": "QG-02-TX-01927-2024-V2-TSC", "nameOfQualification": "Ring Frame Tenter", "description": "A ring frame tenter is responsible for carrying out tenting activities in a ring frame machine. A ring frame tenter should be able to creel the roving bobbin, piece the yarn and carry out routine cleaning and preventive maintenance activities to produce defect free yarn and ensure quality ring cops are produced in ring frame machine. This job requires the individual to have thorough knowledge of process flow and material flow in a spinning mill for yarn production and should know about the important functions and operations of a ring frame machine.", "qualCategoryText": "QUALIFICATION", "qFileAttachId": 131218674, "categoryOfQual": "Qualification", "nosWithMCFlag": false, "nsqfLevel": "2", "sector": "Textile and Handloom", "awardingBodyName": "Textile Sector Skill Council", "typeOfQualification": "General, Upskilling", "isAdopted": null, "fromWhomHeAdopted": null, "leaningUnitGrid": [{"NSQF_LEVEL": "2", "CREDITS": 1.5, "SR_NO": 1, "NATIONAL_HOURS": 45, "NAME": "Taking charge of shift and handing over shift to Ring Frame Tenter"}, {"NSQF_LEVEL": "2", "CREDITS": 1.5, "SR_NO": 2, "NATIONAL_HOURS": 45, "NAME": "Creeling the roving bobbin at Ring Frame"}, {"NSQF_LEVEL": "2", "CREDITS": 1.5, "SR_NO": 3, "NATIONAL_HOURS": 45, "NAME": "Piecing the broken yarn at Ring Frame"}, {"NSQF_LEVEL": "2.5", "CREDITS": 2.5, "SR_NO": 4, "NATIONAL_HOURS": 75, "NAME": "Carryout cleaning activities at Ring Frame"}, {"NSQF_LEVEL": "3", "CREDITS": 0.5, "SR_NO": 5, "NATIONAL_HOURS": 15, "NAME": "Comply with industry and organizational requirement"}, {"NSQF_LEVEL": "3", "CREDITS": 1.5, "SR_NO": 6, "NATIONAL_HOURS": 45, "NAME": "Maintain health, safety and security at workplace"}, {"NSQF_LEVEL": "3", "CREDITS": 0.5, "SR_NO": 7, "NATIONAL_HOURS": 15, "NAME": "Maintain work area, tools and machines"}, {"NSQF_LEVEL": "3", "CREDITS": 0