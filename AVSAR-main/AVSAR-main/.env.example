# ======================================================================
# Project AVSAR — environment template  (TECH_STACK.md §5)
# Copy to .env:  cp .env.example .env
# NO REAL KEYS IN GIT. Defaults below run the FULL demo offline, zero keys.
# ======================================================================

# ---------- Core ----------
ENV=demo                       # demo|prod
DATABASE_URL=postgresql+psycopg://avsar:avsar@db:5432/avsar
REDIS_URL=redis://redis:6379/0
JWT_SECRET=change-me-in-prod-avsar-demo-secret
JWT_ACCESS_MIN=30
JWT_REFRESH_H=12
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# ---------- LLM (verbalizer) ----------
# LLM_PROVIDER=mock keeps the whole journey offline. anthropic = real adapter.
LLM_PROVIDER=mock              # mock|anthropic|template
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5
LLM_MAX_TOKENS=512

# ---------- Speech providers ----------
VOICE_PROVIDER=mock            # sarvam|bhashini|azure|whisper|mock  (mock = zero-key offline demo)
VOICE_PROVIDER_ORDER=sarvam,bhashini,azure,whisper,mock
BHASHINI_USER_ID=
BHASHINI_API_KEY=
BHASHINI_CONFIG_URL=https://meity-auth.ulcacontrib.org/ulca/apis/v0/model/getModelsPipeline
BHASHINI_CONFIG_CACHE_S=600    # ~10 min config cache (TECH_STACK §2.1)
# Sarvam is the live provider AVSAR runs on when keys are present (Bhashini
# ULCA approval is not available to this team). Leaving VOICE_PROVIDER=mock
# above keeps the zero-key offline demo working; set VOICE_PROVIDER=sarvam
# (or run `make mock-off`) once SARVAM_API_KEY is filled in.
SARVAM_API_KEY=
SARVAM_BASE=https://api.sarvam.ai
SARVAM_STT_MODEL=saaras:v3     # saaras:v3 | saaras:v4  (saarika:* is legacy)
SARVAM_STT_MODE=transcribe     # transcribe keeps the beneficiary's language
SARVAM_TTS_MODEL=bulbul:v3     # bulbul:v2 is DEPRECATED server-side (HTTP 400)
SARVAM_TTS_SPEAKER=shubh       # v3: shubh|aditya|ritu|priya|neha|rahul|pooja|... (v2 voices are invalid on v3)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
VOICE_TIMEOUT_S=8
PROVIDER_DEMOTE_AFTER=2

# ---------- Embeddings ----------
# auto = use multilingual-e5-base when installed, else deterministic hashing fallback
EMBEDDING_BACKEND=auto         # auto|e5|hashing
EMBEDDING_MODEL=intfloat/multilingual-e5-base
EMBEDDING_DIM=768

# ---------- Ingestion (pipelines only — NEVER runtime, RULE 3) ----------
PMAJAY_BASE=https://pmajay.dosje.gov.in
KAUSHALVERSE_BASE=https://kaushalverse.ncvet.gov.in
INGEST_QPS=1                   # politeness: 1 request/second
INGEST_UA=AVSAR-SIH-Research/1.0 (+https://github.com/avsar; contact: team@avsar.demo)
ALLOW_LIVE_CHECK=false         # gates the optional /admin/live-check endpoint only

# ---------- Demo switches ----------
MOCK_OTP=123456
SEED_DEMO_USERS=true
DEMO_OFFICER_EMAIL=officer@demo
DEMO_OFFICER_PASSWORD=avsar-demo-2026
DEMO_VIEWER_EMAIL=viewer@demo
DEMO_VIEWER_PASSWORD=avsar-demo-2026
DEMO_ADMIN_EMAIL=admin@demo
DEMO_ADMIN_PASSWORD=avsar-demo-2026

# ---------- Retention (ARCHITECTURE §11) ----------
RETENTION_DAYS=90

# ---------- Startup (ARCHITECTURE §10) ----------
# Load the embedding model in a background thread when core starts. With it off,
# the FIRST beneficiary turn after a cold boot pays the model load (measured
# 11.8 s on a 4-core laptop). Leave it on for demos.
WARM_START=true

# ---------- Rate limits (TECH_STACK §9) ----------
RATE_LIMIT_AUTH_PER_MIN=10
RATE_LIMIT_TURN_PER_MIN=30

# ---------- Web (apps/web) ----------
NEXT_PUBLIC_CORE_URL=http://localhost:8000
CORE_URL=http://core:8000
